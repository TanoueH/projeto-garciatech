{
  "name": "Agente 03 — Controle de Pendências da Obra",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const inputOriginal = $input.first().json;\nconst input = inputOriginal.body ?? inputOriginal;\n\nconst descricao = String(input.descricao || '').trim();\nconst descricaoLower = descricao.toLowerCase();\n\nfunction classificarCategoria(texto) {\n  if (texto.includes('foto') || texto.includes('registro fotográfico')) return 'DOCUMENTACAO';\n  if (texto.includes('material') || texto.includes('entrega') || texto.includes('nota')) return 'SUPRIMENTOS';\n  if (texto.includes('segurança') || texto.includes('epi') || texto.includes('risco')) return 'SEGURANCA';\n  if (\n  texto.includes('projeto executivo') ||\n  texto.includes('desenho técnico') ||\n  texto.includes('desenho tecnico') ||\n  texto.includes('revisão de projeto') ||\n  texto.includes('revisao de projeto')\n) {\n  return 'PROJETO';\n}\n  if (texto.includes('execução') || texto.includes('alvenaria') || texto.includes('concretagem')) return 'EXECUCAO';\n  return 'GERAL';\n}\n\nfunction classificarPrioridade(texto) {\n  if (texto.includes('crítico') || texto.includes('critico') || texto.includes('risco') || texto.includes('segurança')) {\n    return 'CRITICA';\n  }\n\n  if (texto.includes('necessário') || texto.includes('necessario') || texto.includes('confirmar') || texto.includes('não foram enviadas')) {\n    return 'ALTA';\n  }\n\n  if (texto.includes('verificar') || texto.includes('pendente')) {\n    return 'NORMAL';\n  }\n\n  return 'BAIXA';\n}\n\nconst categoria = classificarCategoria(descricaoLower);\nconst prioridade = classificarPrioridade(descricaoLower);\n\nlet acao_recomendada = 'Registrar pendência e acompanhar até resolução.';\n\nif (categoria === 'DOCUMENTACAO') {\n  acao_recomendada = 'Solicitar complementação documental ou envio das evidências faltantes.';\n}\n\nif (categoria === 'SUPRIMENTOS') {\n  acao_recomendada = 'Conferir documentação de entrega, nota fiscal, quantitativos e impacto no cronograma.';\n}\n\nif (categoria === 'SEGURANCA') {\n  acao_recomendada = 'Acionar responsável técnico imediatamente para verificação das condições de segurança.';\n}\n\nif (categoria === 'EXECUCAO') {\n  acao_recomendada = 'Solicitar validação da frente de serviço e registro das evidências de execução.';\n}\n\nconst historico = {\n  eventos: [\n    {\n      data: new Date().toISOString(),\n      status: 'ABERTA',\n      descricao: 'Pendência registrada automaticamente pelo Agente 03.',\n      agente: 'Agente Controle de Pendências'\n    }\n  ]\n};\n\nreturn [\n  {\n    json: {\n      obra_codigo: input.obra_codigo || null,\n\n      origem: input.origem || 'WEBHOOK',\n      origem_tipo: input.origem_tipo || null,\n      origem_id: input.origem_id || null,\n\n      data_identificacao: input.data_identificacao || null,\n      responsavel_identificacao: input.responsavel_identificacao || null,\n\n      descricao,\n      categoria,\n      prioridade,\n      status_pendencia: 'ABERTA',\n\n      responsavel_acao: input.responsavel_acao || null,\n      prazo_limite: input.prazo_limite || null,\n\n      acao_recomendada,\n      observacoes: null,\n\n      evidencias: input.evidencias || {},\n      historico,\n      payload_original: {\n        entrada_original: inputOriginal,\n        entrada_normalizada: input\n      },\n\n      agente_nome: 'Agente Controle de Pendências da Obra',\n      agente_versao: '0.1.0',\n      modo_processamento: 'MOCK',\n      data_processamento: new Date().toISOString()\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
