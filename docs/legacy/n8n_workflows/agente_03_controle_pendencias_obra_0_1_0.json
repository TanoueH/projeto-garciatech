        "jsCode": "const item = $input.first().json;\n\nfunction safeObject(value) {\n  if (!value) return {};\n\n  if (typeof value === 'object') {\n    return value;\n  }\n\n  try {\n    return JSON.parse(value);\n  } catch (error) {\n    return {\n      valor_original: String(value)\n    };\n  }\n}\n\nreturn [\n  {\n    json: {\n      ...item,\n\n      evidencias: safeObject(item.evidencias),\n      historico: safeObject(item.historico),\n      payload_original: safeObject(item.payload_original),\n\n      data_identificacao: item.data_identificacao || null,\n      prazo_limite: item.prazo_limite || null,\n      data_processamento: item.data_processamento || new Date().toISOString()\n    }\n  }\n];"
